# Sister repos (nested, independent git history)
/fitACE/

# External tools and data
external/

# Scripts (local benchmarks / utilities); root-only, with the tracked exceptions below
/scripts/*
!/scripts/audit_results_footprint.py
!/scripts/calibrate_frailty_scale.py
# Fresh-computer install-verification suite (shareable; see scripts/verify/README.md)
!/scripts/verify/
# Standalone docs-example plots and gene-drop pipeline
!/scripts/examples/
!/scripts/gene_drop/

# Notebooks
notebooks/

# Results and outputs
results/
logs/
benchmarks/

# Workflow-engine state left by checkouts that ran the pipeline before ADR 0020
.snakemake/

# MkDocs build output
site/

# Conda environment
env/

# pixi-managed canonical simACE environment (ADR 0016; pixi.lock is tracked)
.pixi/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.coverage

# Generated PDFs
*.pdf

# PowerPoint docs
docs/*.pptx

# Lock files (LibreOffice, etc.)
.~lock.*

# Working notes
notes/
improve_tetra.md
plots.md
validation.md
claude memory notes analyze.md

# OS
.DS_Store
Thumbs.db

#Pycharm
.idea

# Presentations
presentations/

# LLM coding-agent harnesses: Claude Code, Codex, Pi (see docs/agents/harnesses.md).
# Machine-local; AGENTS.md is tracked as a symlink to CLAUDE.md (single source of truth).
.claude/
.codex/
.pi/
.agents/
skills-lock.json

# Hypothesis property-based testing example database
.hypothesis/

# Immutable benchmark run directories (python -m tools.benchmark). The harness
# is tracked; measurements remain machine-local or GitHub Actions artifacts.
bench-logs*/

# Working plan drafts (design-interview output). Finalized plans are promoted
# to docs/plans/ (tracked). Keep the README so the location stays predictable.
plans/*
!plans/README.md

# Throwaway probe scripts. Ruff respects .gitignore when it walks the tree, so
# ignoring these also keeps a one-off probe out of the lint and release gates.
scratchpad/
