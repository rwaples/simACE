# Sister repos (nested, independent git history)
/fitACE/
/ADHD_heritability/

# External tools and data
external/

# Scripts (local benchmarks / utilities); root-only so workflow/scripts/ stays tracked
/scripts/*
!/scripts/migrate_prevalence_keys.py
!/scripts/audit_results_footprint.py
!/scripts/regen_rulegraph.sh
!/scripts/calibrate_frailty_scale.py
# Fresh-computer install-verification suite (shareable; see scripts/verify/README.md)
!/scripts/verify/

# Notebooks
notebooks/

# Results and outputs
results/
logs/
benchmarks/

# Snakemake
.snakemake/

# MkDocs build output
site/

# Conda environment
env/

# pixi-managed canonical simACE environment (ADR 0016; pixi.lock is tracked)
.pixi/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.coverage

# Generated PDFs
*.pdf

# PowerPoint docs
docs/*.pptx

# Lock files (LibreOffice, etc.)
.~lock.*

# Working notes
notes/
improve_tetra.md
plots.md
validation.md
claude memory notes analyze.md

# OS
.DS_Store
Thumbs.db

#Pycharm
.idea

# Presentations
presentations/

# LLM coding-agent harnesses: Claude Code, Codex, Pi (see docs/agents/harnesses.md).
