.claude/
.codex/
.pi/
.agents/
skills-lock.json

# Hypothesis property-based testing example database
.hypothesis/

# Benchmark run output (tools/bench_pipeline.sh). The scripts are tracked;
# the measurements they produce are machine-local.
bench-logs/

# Working plan drafts (design-interview output). Finalized plans are promoted
